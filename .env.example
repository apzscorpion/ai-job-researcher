# REQUIRED — the app refuses to start without real values.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Production: the site's address(es), comma-separated (who may call the API from a browser)
ALLOWED_ORIGINS=http://localhost:5173
# Accounts that may read server logs (comma-separated)
ADMIN_EMAILS=
# How long a login lasts
TOKEN_HOURS=24
# Set to 1 only on a development machine to expose /docs
API_DOCS=0

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest
